{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dm2-tool/schemas/trace-lineage.json",
  "title": "dm2 trace lineage --json Response Data",
  "description": "跨变更追溯：哪些视图的溯源引用了给定术语或能力。",
  "type": "object",
  "properties": {
    "criterion": { "type": "string", "enum": ["term", "capability"] },
    "value": { "type": "string" },
    "count": { "type": "integer", "minimum": 0 },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "view_id": { "type": "string" },
          "change": { "type": "string" },
          "creation_date": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "pedigree_status": {
            "type": "string",
            "enum": ["complete", "incomplete", "absent"]
          }
        },
        "required": ["view_id", "change", "creation_date", "confidence", "pedigree_status"]
      }
    },
    "by_change": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    }
  },
  "required": ["criterion", "value", "count", "views", "by_change"]
}
