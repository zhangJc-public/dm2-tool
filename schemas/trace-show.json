{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dm2-tool/schemas/trace-show.json",
  "title": "dm2 trace show --json Response Data",
  "description": "单个视图的完整溯源记录；pedigree 为 null 表示没有记录。",
  "type": "object",
  "properties": {
    "view_id": { "type": "string" },
    "pedigree": { "type": ["object", "null"] },
    "pedigree_status": { "type": "string", "enum": ["complete", "incomplete", "absent"] },
    "pedigree_missing": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["view_id", "pedigree", "pedigree_status", "pedigree_missing"]
}
